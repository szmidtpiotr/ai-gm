# --- Backend: ai-gm w katalogu nadrzędnym do /backend
# Pliki w korzeniu repo: .env, env.test — backend ładuje je przy starcie (app/bootstrap_env.py)
# tylko dla brakujących kluczy; nie nadpisuje exportu (np. w systemd).
# Np. w env.test: AI_TEST_MODE=1 włącza /api/test_runner i /api/debug/* w trybie testowym.
# AI_TEST_STUB_LLM=1 — tryb stub GM (gdy brak Ollamy); w Test Runner też włącza szkic czatu planistycznego.
# Nie ustawiaj AI_TEST_STUB_LLM=0 w docker-compose.dev (nadpisuje plik mountowany env.test).
#
# Test Runner (Playwright): w docker-compose.dev.yml backend ma na stałe AI_TEST_AGENT_URL=http://test-agent:4000
# (żeby .env przy compose nie nadpisywał na host.docker.internal). Uruchom:
# docker compose -f docker-compose.dev.yml up -d --build test-agent
# Własny URL agenta: plik docker-compose.override.yml z sekcją services.backend.environment.

# LLM provider type: ollama or openai
LLM_PROVIDER=ollama

# LLM server base URL (for ollama: host:11434, for openai: API base)
LLM_BASE_URL=http://host.docker.internal:11434

# Default model name used by backend if not provided per-request
LLM_MODEL=gemma4:e4b

# Optional API key / bearer token; leave empty for no auth
LLM_API_KEY=

# Planer kroków Test Runnera (kontener test-agent, ai_test_agent/agent/llm_client.js) — OSOBNY od LLM_BACKEND/GM.
# Na serwerze bez Ollamy ustaw ten sam zewn. API co gra (OpenAI-compat /v1/chat/completions), np.:
# LLM_API_URL=https://api.openai.com/v1/chat/completions   (w sekcji environment: test-agent w docker-compose)
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
# Albo w panelu admin: «Własne połączenie LLM» — wtedy parametry idą w body /api/test_runner/start (nie wymagają zmiany compose).

# Optional: Loki base URL if not set in Admin → Observability (SQLite game_config_meta.loki_url).
# Precedence: database → LOKI_URL → (default http://loki:3100 on first DB migrate).
# LOKI_URL=http://loki:3100

# =============================================================
# Additional environment variables actually read by the backend.
# All optional at runtime (sane fallbacks in code); listed here so a
# fresh clone knows what can be tuned. Uncomment + fill what you need.
# =============================================================

# --- Auth / core ---
# JWT signing secret — persists login sessions across rebuilds (#1090).
# Min length enforced by app. Set in host .env; compose passes it through.
# JWT_SECRET=change-me-at-least-32-characters-long
# App environment tag (affects logging / config defaults): dev | prod
# APP_ENV=dev
# SQLite connection string (container path).
# DATABASE_URL=sqlite:////data/ai_gm_dev.db
# Comma-separated allowed CORS origins (default: permissive in dev).
# CORS_ORIGINS=https://aigm-dev.studio-colorbox.com

# --- Public URL for email links (invite / verify / reset) (#866) ---
# Without it links render http:///register (empty host).
# APP_BASE_URL=https://aigm-dev.studio-colorbox.com

# --- Web Push VAPID keys (#593) — generate with pywebpush/py-vapid ---
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_CLAIMS_EMAIL=mailto:admin@studio-colorbox.com

# --- GitHub (bug-report → issue creation) ---
# Personal access token with repo scope; leave empty to disable auto-filing.
# GITHUB_PAT=
# GITHUB_REPO=szmidtpiotr/ai-gm

# --- Telegram (tester channel notifications) ---
# TELEGRAM_BOT_TOKEN=

# --- Language ---
# DEFAULT_CAMPAIGN_LANGUAGE=pl
# GAME_LANG=pl-PL

# --- Narrative logging (verbose story/turn debug to disk) ---
# NARRATIVE_STORY_LOG=0
# NARRATIVE_LOG_MAX_CHARS=4000
# SSE_NARRATIVE_PROGRESS_LOG=0

# --- Image generation (dungeon tiles / enemy portraits) ---
# IMAGE_GEN_URL=http://192.168.1.170:8765
# DUNGEON_IMAGE_GEN_URL=
# DUNGEON_IMAGE_GEN_MODEL=
# DUNGEON_IMAGE_GEN_SIZE=
# DUNGEON_IMAGE_GEN_TIMEOUT=

# --- Ollama tuning ---
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_TIMEOUT=240

# =============================================================
# Test / E2E mode — normally set via env.test (see env.test.example),
# NOT here. Listed for reference only.
#   AI_TEST_MODE=1            enables Test Runner + /api/debug/* + seeds test user
#   AI_TEST_STUB_LLM=1        deterministic stub GM (no live LLM)
#   AI_TEST_STUB_LLM_TEXT=... canned stub narration
#   AI_TEST_DB_PATH=/data/ai_gm.db
#   AI_TEST_CONFIG_PATH=/data/ai_test_config.json
#   AI_TEST_AGENT_URL=http://test-agent:4000
#   AI_TEST_SCENARIOS_DIR=/data/ai_test_scenarios
# =============================================================
