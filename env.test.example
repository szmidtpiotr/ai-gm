# Copy to env.test for local E2E / test mode (gitignored).
#   cp env.test.example env.test
#
# Used by docker-compose.dev.yml mount and local backend if present.
# See docs/GETTING_STARTED.md for full local test workflow.

AI_TEST_MODE=1
AI_TEST_STUB_LLM=1
AI_TEST_STUB_LLM_TEXT=[E2E] The GM speaks with a steady voice. The path ahead is clear.

# Auth for /api/auth/login in tests (min length enforced by app).
JWT_SECRET=e2e-jwt-secret-at-least-32-characters-long

AI_TEST_CONFIG_PATH=/data/ai_test_config.json
