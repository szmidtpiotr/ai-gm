# Seed template for env.test on the DEV stack (gitignored — deploy_dev.sh kopiuje go, gdy env.test brak).
#   cp env.test.example env.test
#
# Used by docker-compose.dev.yml mount. Ten plik seeduje TYLKO tryb testowy DEV: AI_TEST_MODE=1
# (seed test-usera/kampanii). NIE ustawiaj tu AI_TEST_STUB_LLM=1 — DEV gra na żywym LLM.
# Stub GM należy WYŁĄCZNIE do E2E: docker-compose.e2e.yml ustawia AI_TEST_STUB_LLM=1 inline.
# (Regresja #1179: STUB=1 w tym templacie włączył [E2E]-owe odpowiedzi GM na DEV.)

AI_TEST_MODE=1
# AI_TEST_STUB_LLM — celowo nieustawione na DEV; compose pieczętuje =0. Włącza je tylko e2e compose.

# Auth for /api/auth/login in tests (min length enforced by app).
JWT_SECRET=e2e-jwt-secret-at-least-32-characters-long

AI_TEST_CONFIG_PATH=/data/ai_test_config.json
