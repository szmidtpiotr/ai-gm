      "id": 1,
      "type": "timeseries",
      "title": "Turn Requests / min",
      "datasource": {
        "type": "loki",
        "uid": "PD5A68A3BD6F8BA56"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"backend\", env=\"dev\", container=\"ai-gm-dev-backend-1\"} | json | event=\"request_complete\" | route=~\".*/turns.*\" [1m]))",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
