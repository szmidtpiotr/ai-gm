# Docker
*.log

# DB bind-mount data directory (ignore DB files; keep data/.gitkeep and backups/.gitkeep tracked)
data/*
!data/.gitkeep
!data/game_config_seed.sql
!data/seeds/
data/seeds/*
!data/seeds/*.sql
!data/seeds/*.json
!data/seeds/tile_categories/
backups/*
!backups/.gitkeep
ollama/
__pycache__/
*.pyc
.env
env.test
.secrets/
.DS_Store
.venv/

# NFS stale handles (cannot delete while open elsewhere)
frontend/.nfs*

# Generated by install.sh
install-summary.txt

*.bak

# Ephemeral SQLite sidecars next to pytest DBs under backend/tests/
backend/tests/*.db-shm
backend/tests/*.db-wal

# Local SQLite snapshot for Grafana/MCP (install.sh --with-observability)
observability-data/

# Generated by scripts/db-autosync.sh --install-cron
scripts/.db-autosync-cron-wrap.sh

# Dokumentacja projektu (`docs/`) jest wersjonowana w repozytorium (GitHub / edycja z telefonu).
/skills/
data-dev/
backend/ai_test_config.json

# Observability DEV - dane runtime (nie commitujemy)
observability-dev/loki/data/
observability-dev/grafana/data/

# Voice service runtime models
voice-service/models/tts/*.onnx
voice-service/models/tts/*.onnx.json
voice-service/models/stt/

# MCP server config (contains API keys)
.mcp.json

# Claude Code session data (settings may contain API keys)
# Use wildcard so negation of skills/ can work (git won't descend into ignored dirs)
.claude/*
!.claude/skills/
!.claude/mass-implement.json

# Stray SQLite DB files at project root (data/ is the real mount)
backend/ai_gm.db

# Downloaded binaries
*.tar.gz

# TaskMaster config (contains GitHub PAT token) — never commit
.taskmaster/

# Scratch screenshots / temp images
temp-img/

# Throwaway dev artifacts
.playwright-mcp/
mag-game-screen*.png
.GitHubBoard/

# graphify trial — code-graph artifacts (local, not committed)
graphify-out/
