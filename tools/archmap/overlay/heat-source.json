{
  "_doc": "Maps runtime event/call types -> map node ids, so update_heat.py can colour nodes by real traffic. NOW: uses combat_turns.event_type (already exists). PHASE 11: add game_events.event_type and llm_call_log.call_type rows here once those tables land — same shape, no code change.",
  "db": {
    "ssh_host": "claude@192.168.1.61",
    "container": "ai-gm-dev-backend-1",
    "db_path": "/data/ai_gm.db",
    "local_docker": true
  },
  "sources": [
    {
      "table": "combat_turns",
      "type_col": "event_type",
      "error_predicate": "0",
      "latency_col": null,
      "window_days": 30,
      "map": {
        "attack": "resolve-attack",
        "death": "resolve-attack",
        "start": "initiate-combat",
        "initiative": "initiate-combat",
        "zone_change": "zones",
        "behavior": "conditions",
        "detection": "conditions",
        "*": "log-event"
      }
    },
    {
      "_phase11": true,
      "table": "game_events",
      "type_col": "event_type",
      "error_predicate": "severity = 'error'",
      "latency_col": null,
      "window_days": 7,
      "map": {
        "combat_victory": "resolve-attack",
        "player_death": "solo-death",
        "*": "log-event"
      }
    },
    {
      "_phase11": true,
      "table": "llm_call_log",
      "type_col": "call_type",
      "error_predicate": "error IS NOT NULL",
      "latency_col": "latency_ms",
      "window_days": 7,
      "map": {}
    }
  ]
}
